# ==============================================================================
# KRS CREATOR HUB - ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# NEXT PUBLIC URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SUPABASE CONFIGURATION
# Obtenha estas chaves no painel do seu projeto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# SUPABASE SERVICE ROLE (OPCIONAL - USADO APENAS SERVER-SIDE PARA CRON E ADMIN ACTIONS)
# NUNCA exponha esta chave no frontend com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# MODO DEMO / LOCAL REACTIVE ENGINE
# Quando definido como "true", permite navegar e testar 100% dos recursos com dados seed reativos
# mesmo que as variáveis do Supabase ainda não tenham sido configuradas.
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
